# Default settings for contrib/crossbuild/build-matrix.sh
# Copy and edit values to match your server/build machine.

# Target host triplets
LINUX_HOST=x86_64-pc-linux-gnu
WINDOWS_HOST=x86_64-w64-mingw32

# Parallelism
MAKE_JOBS=8
MAKE_DEPENDS_JOBS=8

# Build directories
# BUILD_BASE_DIR=/absolute/path/to/out/build
# ARTIFACTS_DIR=/absolute/path/to/out/artifacts

# Configure flags (examples)
# CONFIGURE_FLAGS_COMMON="--enable-reduce-exports"
# CONFIGURE_FLAGS_LINUX=""
# CONFIGURE_FLAGS_WINDOWS=""

# Set RUN_AUTOGEN=0 if you already ran ./autogen.sh
RUN_AUTOGEN=1
